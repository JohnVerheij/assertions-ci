{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Amsterdam)",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": [
    "before 4am"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Same commit convention as the package repositories: `ci(github-actions): ...` for action bumps.",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "github-actions"
    }
  ]
}
